{
  "name": "vagou-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts latest",
    "db:rollback": "tsx --env-file-if-exists=.env scripts/migrate.ts down",
    "admin:criar": "tsx --env-file-if-exists=.env scripts/create-admin.ts",
    "openapi:export": "tsx scripts/export-openapi.ts",
    "db:codegen": "kysely-codegen --env-file .env"
  },
  "dependencies": {
    "@fastify/autoload": "^6.6.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/error": "^4.3.0",
    "@fastify/jwt": "^10.2.8",
    "@fastify/rate-limit": "^11.3.0",
    "@fastify/swagger": "^9.9.5",
    "@fastify/swagger-ui": "^6.1.5",
    "@fastify/type-provider-typebox": "^6.3.0",
    "@node-rs/argon2": "^2.2.2",
    "ajv-formats": "^3.0.1",
    "fastify": "^5.12.8",
    "fastify-plugin": "^6.0.1",
    "kysely": "^0.29.9",
    "pg": "^8.23.1",
    "typebox": "^1.4.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "kysely-codegen": "^0.20.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  }
}
