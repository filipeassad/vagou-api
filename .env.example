# Copie para .env e ajuste. Nunca commite o .env (segredos).

NODE_ENV=development
HOST=0.0.0.0
PORT=3333
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Obrigatória. Postgres do docker-compose na porta 5433 (npm run db:up)
DATABASE_URL=postgres://vagou:vagou@localhost:5433/vagou
# Banco dos testes (criado e migrado automaticamente pelo npm test)
DATABASE_URL_TEST=postgres://vagou:vagou@localhost:5433/vagou_test

# Obrigatória. Mínimo de 32 caracteres. Gere com:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

WEB_ORIGIN=http://localhost:5173

# Notificações (e-mails de redefinição de senha, convites, aprovação de cadastro):
#   console = imprime no log da API (desenvolvimento; os links aparecem no terminal)
#   memory  = guarda na memória (testes)
#   email   = envia de verdade (obrigatório em produção; fornecedor ainda a definir)
NOTIFIER=console
# Remetente, exigido com NOTIFIER=email
# EMAIL_FROM=Vagou <nao-responda@vagou.com.br>
